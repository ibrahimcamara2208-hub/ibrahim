<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Inscription Nouveau Client - Méditerranée</title>
</head>
<body>
	<form action="#" method="post">
	
	  <h1> Inscription D'un Nouveau Client </h1>
	  <label for="nom">Nom :</label>
	  <input type="text" id="nom" name="nom">
	  <br>
	  <br>
	  <label for="prenom">Prenom :</label>
	  <input type="text" id="prenom" name="prenom">
	  <br>
	  <br>
	  <label for="date de naissance">Date de naissance :</label>
	  <input type="date" id="date de naissance" name="date de naissance">
	  <br>
	  <br>
	  <label for="email">Adresse mail :</label>
	  <input type="email" id="email" name="email">
	  <br>
	  <br>
	  <label for="mdp">Mot de passe :</label>
	  <input type="password" id="mdp" name="mdp">
	  <br>
	  <br>
	  <label for="permis">Numéro de permis :</label>
	  <input type="text" id="permis" name="permis">
	  <br>
	  <br>
	  <label for="anciennete">Nombre d'années d'ancienneté :</label>
	  <input type="number" id="anciennete" name="anciennete" min="0" max="80">
	  <br>
	  <br>
	  <label for="ville">ville :</label>
	  <select id="ville" name="ville">
	  	 <option value="paris">Paris</option>
	  	 <option value="versailles">Versaille</option>
	  	 <option value="créteil">Créteil</option>
	  </select>
	  <br>
	  <br>
	  <label for="adresse">Adresse du client :</label>
	  <textarea id="adresse" name="adresse" rows="4" cols="30"></textarea>
	  <br>
	  <br>
	  <p>Situation matrimonale :</p>
	  <label for="marie_oui">Marié</label>
	  <input type="radio" id="marie_oui" name="marie" value="oui">
	  <label for="marie_non">Non marié</label>
	  <input type="radio" id="marie_non" name="marie" value="non">
	  <br>
	  <br>
	  <p>Préférence de voiture :</p>
	  <label for="pref_auto">Automatique</label>
	  <input type="checkbox" id="pref_manuelle" name="preference_manuelle" value="manuelle">
	  <br>
	  <br>
	  <button type="submit">Enregistrer</button>
	  <button type="reset">Annuler</button>

	  <body>

	  	 <header>
	  	 	<h1>Inscription d'un Nouveau client</h1>
	  	 </header>

	  	 <section>
	  	 	<form action="#" method="post">
	  	 	</form>
	  	</section> 		
	  	<footer>
	  		<p>&copy; 2026 Agence Méditerranée - Location de véhicules</p>
	  	</footer>	
	  


</body>
</html>